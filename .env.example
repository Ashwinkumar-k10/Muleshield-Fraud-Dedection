# MuleShield PRO v2 - Environment Configuration
# Copy this file to .env and configure as needed. Never commit real credentials.

# Database Configuration
POSTGRES_USER=muleshield
POSTGRES_PASSWORD=muleshield_secure
POSTGRES_DB=muleshield_db
DATABASE_URL=postgresql://muleshield:muleshield_secure@postgres:5432/muleshield_db

# Flask Server Config
FLASK_ENV=production
PORT=8000
HOST=0.0.0.0

# JWT Secret (CHANGE IN PRODUCTION)
JWT_SECRET_KEY=change-me-in-production

# Service URLs (internal Docker network)
ML_SERVICE_URL=http://ml-service:8080
GRAPH_SERVICE_URL=http://graph-service:8081
REPORTING_SERVICE_URL=http://reporting-service:8082

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
