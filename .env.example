# MuleShield PRO v2 - Environment Configuration Example
# Copy this file to .env and configure as needed. Never commit real credentials.

# Database Configuration
# Fallback to local SQLite if DATABASE_URL is not set or empty
# Example PostgreSQL: postgresql://muleshield:muleshield_secure@localhost:5432/muleshield_db
DATABASE_URL=sqlite:///muleshield_local.db

# Flask Server Config
FLASK_ENV=development
PORT=8000
HOST=0.0.0.0
